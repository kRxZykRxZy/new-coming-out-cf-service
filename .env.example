# Database configuration
# Set DB_TYPE to 'sqlite' or 'postgres'
DB_TYPE=sqlite

# For SQLite: path to database file (optional, defaults to ./database.sqlite)
DB_PATH=./database.sqlite

# For PostgreSQL: full connection URL
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# CloudCast base domain used for subdomains
BASE_DOMAIN=cloudcast.dev

# Allowed CORS origin for the web app
CORS_ORIGIN=http://localhost:5173
